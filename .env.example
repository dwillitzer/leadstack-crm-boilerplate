# ======================
# Firebase Client SDK
# ======================
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ======================
# Firebase Admin SDK
# ======================
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Paste the private key from your service account JSON (include the -----BEGIN/END----- markers)
FIREBASE_ADMIN_PRIVATE_KEY=

# ======================
# Stripe
# ======================
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# The Stripe Price ID for the Pro subscription plan
STRIPE_PRO_PRICE_ID=

# ======================
# App
# ======================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ======================
# Cookie Secrets (for next-firebase-auth-edge)
# Generate with: openssl rand -base64 32
# ======================
COOKIE_SECRET_CURRENT=
COOKIE_SECRET_PREVIOUS=

# ======================
# Email (Resend)
# Shared sender — get an API key at https://resend.com and verify your
# sending domain under Domains. EMAIL_FROM must be on a verified domain.
# ======================
RESEND_API_KEY=
EMAIL_FROM="LeadStack <notifications@example.com>"

# ======================
# SMS (Twilio)
# Shared sender — get credentials at https://console.twilio.com. Trial
# accounts can only send to verified numbers and prepend a trial banner.
# ======================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
